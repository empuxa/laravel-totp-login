{
    "name": "empuxa/laravel-totp-login",
    "description": "Passwordless login using short-lived one-time codes delivered by email.",
    "keywords": [
        "empuxa",
        "totp-login",
        "passwordless"
    ],
    "homepage": "https://github.com/empuxa/laravel-totp-login",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Raddatz",
            "email": "marco@empuxa.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^9.52|^10.0|^11.0|^12.61.1|^13.12.0",
        "illuminate/events": "^9.52|^10.0|^11.0|^12.61.1|^13.12.0",
        "illuminate/notifications": "^9.52|^10.0|^11.0|^12.61.1|^13.12.0",
        "illuminate/routing": "^9.52|^10.0|^11.0|^12.61.1|^13.12.0",
        "illuminate/support": "^9.52|^10.0|^11.0|^12.61.1|^13.12.0",
        "illuminate/view": "^9.52|^10.0|^11.0|^12.61.1|^13.12.0",
        "spatie/laravel-package-tools": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10",
        "orchestra/testbench": "^7.25|^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Empuxa\\TotpLogin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Empuxa\\TotpLogin\\Tests\\": "tests"
        }
    },
    "scripts": {
        "pint": "./vendor/bin/pint",
        "test": "./vendor/bin/pest --no-coverage",
        "test:coverage": "./vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Empuxa\\TotpLogin\\TotpLoginServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "conflict": {
        "guzzlehttp/guzzle": "<7.15.2|>=8.0.0,<8.0.1",
        "guzzlehttp/psr7": "<2.12.3",
        "league/commonmark": "<2.10.0",
        "symfony/http-foundation": "<5.4.50|>=6.0,<6.4.41|>=7.0,<7.4.13|>=8.0,<8.0.13",
        "symfony/mailer": "<5.4.52|>=6.0,<6.4.40|>=7.0,<7.4.12|>=8.0,<8.0.12",
        "symfony/mime": "<5.4.52|>=6.0,<6.4.40|>=7.0,<7.4.12|>=8.0,<8.0.12",
        "symfony/polyfill-intl-idn": "<1.38.1",
        "symfony/process": "<5.4.51|>=6.0,<6.4.33|>=7.0,<7.3.11|>=7.4,<7.4.5|>=8.0,<8.0.5",
        "symfony/routing": "<5.4.53|>=6.0,<6.4.41|>=7.0,<7.4.13|>=8.0,<8.0.13",
        "symfony/yaml": "<5.4.52|>=6.0,<6.4.40|>=7.0,<7.4.12|>=8.0,<8.0.12"
    }
}
